# --- Backend (FastAPI) ---
# Get a free key at https://etherscan.io/apis
ETHERSCAN_API_KEY=

# "sepolia" for the live demo (self-created test wallets),
# "ethereum" / "ethereum-mainnet" for real-world tracing against the
# public exchange wallet list.
ETHERSCAN_NETWORK=sepolia

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
